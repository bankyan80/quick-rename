# Quick Tools — aplikasi berjalan sepenuhnya di peramban (tanpa backend).
# Berikut variabel yang DISARANKAN untuk deployment Vercel (semua opsional).

# Mode demo: seluruh workflow (tambah file → pilih → proses → hasil) menggunakan
# PDF contoh yang dibuatkan di peramban, tanpa mengunggah apa pun.
VITE_DEMO=1

# Domain aplikasi lain di keluarga Quick Tools (untuk navigasi silang).
# Tanpa diisi, menu masuk Quick Tools menggunakan URL default per slug.
VITE_TOOLS_BASE_URL=https://quick-tools.vercel.app

# Folder output build (default: dist).
# VITE_OUTPUT_DIR=dist