generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  googleId      String    @unique
  email         String
  name          String
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  role          String    @default("user")
  tokenAccount  TokenAccount?
  paymentOrders PaymentOrder[]
  renameHistory RenameHistory[]
  tokenTransactions TokenTransaction[]
}

model AnonymousSession {
  id          String   @id @default(cuid())
  sessionHash String   @unique
  freeQuota   Int      @default(5)
  usedFiles   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TokenAccount {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TokenTransaction {
  id           String   @id @default(cuid())
  userId       String
  type         String   // PURCHASE, USAGE, ADJUSTMENT
  amount       Int
  balanceBefore Int
  balanceAfter  Int
  reference    String?
  description  String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PaymentOrder {
  id            String   @id @default(cuid())
  userId        String
  orderNumber   String   @unique
  tokenQuantity Int
  fileQuantity  Int
  amount        Int
  paymentMethod String   // DANA, QRIS
  status        String   @default("PENDING") // PENDING, WAITING_VERIFICATION, APPROVED, REJECTED, EXPIRED, CANCELLED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  verifiedAt    DateTime?
  verifiedBy    String?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  proof         PaymentProof?
}

model PaymentProof {
  id              String   @id @default(cuid())
  paymentOrderId  String   @unique
  reference       String?
  notes           String?
  submittedAt     DateTime @default(now())
  paymentOrder    PaymentOrder @relation(fields: [paymentOrderId], references: [id], onDelete: Cascade)
}

model RenameHistory {
  id          String   @id @default(cuid())
  userId      String?
  operationId String
  fileCount   Int
  summary     String?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model AppSettings {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
